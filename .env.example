EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional development-only fixture catalog. Leave unset/0 to start with user-installed catalogs only.
EXPO_PUBLIC_DEMO_CATALOG=0

# Optional remote catalog endpoint. Production URLs must use HTTPS.
# HTTP is accepted only for localhost/127.0.0.1/::1 development.
EXPO_PUBLIC_CATALOG_BASE_URL=

# Optional remux fallback for sources the browser cannot demux (MKV in WebKit,
# AC-3/E-AC-3 audio in Chromium). See services/remux/README.md.
# Leave unset to disable the fallback: the player then fails over to another
# source and shows why. HTTPS is required for a deployed PWA.
EXPO_PUBLIC_REMUX_URL=
